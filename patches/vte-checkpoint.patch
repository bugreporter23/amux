+
+#[cfg(all(feature = "std", feature = "serde"))]
+mod timeout_checkpoint {
+    use super::*;
+    pub fn serialize<S: serde::Serializer>(timeout: &Option<Instant>, serializer: S) -> Result<S::Ok, S::Error> {
+        let millis = timeout.map(|deadline| deadline.saturating_duration_since(Instant::now()).as_millis() as u64);
+        serde::Serialize::serialize(&millis, serializer)
+    }
+    pub fn deserialize<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Option<Instant>, D::Error> {
+        let millis: Option<u64> = serde::Deserialize::deserialize(deserializer)?;
+        Ok(millis.map(|millis| Instant::now() + Duration::from_millis(millis)))
+    }
+}
