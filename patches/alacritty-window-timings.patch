diff --git a/alacritty/src/renderer/profile.rs b/alacritty/src/renderer/profile.rs
--- /dev/null
+++ b/alacritty/src/renderer/profile.rs
@@ -0,0 +1,30 @@
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+fn cpu_time() -> Option<Duration> {
+    let mut value = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    let status = unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut value) };
+    (status == 0).then(|| Duration::new(value.tv_sec as u64, value.tv_nsec as u32))
+}
+
+pub fn measure<T>(stage: &str, threshold_ms: u64, operation: impl FnOnce() -> T) -> T {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var_os("AMUX_TRACE_TIMINGS").is_some()) {
+        return operation();
+    }
+
+    let cpu_start = cpu_time();
+    let start = Instant::now();
+    let result = operation();
+    let elapsed = start.elapsed();
+    let cpu = cpu_time().zip(cpu_start).map(|(end, begin)| end.saturating_sub(begin));
+    if elapsed >= Duration::from_millis(threshold_ms) {
+        log::info!(
+            "WM_TIMING stage={} wall_ms={:.3} cpu_ms={:?}",
+            stage,
+            elapsed.as_secs_f64() * 1000.,
+            cpu.map(|duration| duration.as_secs_f64() * 1000.),
+        );
+    }
+    result
+}
