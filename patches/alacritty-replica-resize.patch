+    pub fn set_copy_view(&mut self, copy_view: bool) {
+        if self.copy_view == copy_view { return; }
+        self.copy_view = copy_view;
+        self.frame().mark_fully_damaged();
+        self.next_frame().mark_fully_damaged();
+    }
+
+    pub fn collect_terminal_damage<T>(&mut self, terminal: &mut Term<T>) -> bool {
+        if terminal.screen_lines() != self.screen_lines || terminal.columns() != self.columns {
+            return false;
+        }
+        match terminal.damage() {
+            TermDamage::Full => self.frame().mark_fully_damaged(),
+            TermDamage::Partial(lines) => {
+                for damage in lines { self.frame().damage_line(damage); }
+            },
+        }
+        terminal.reset_damage();
+        true
+    }
